# ==========================
# Base
# ==========================
PROJECT_NAME='example'
ROOT_URL='example.com'
CURL_IPRESOLVE='v4'

# ==========================
# Environment
# ==========================
ENVIRONMENT_TYPE='development'
DEBUG=true
DEBUG_DISPLAY=false
DEBUG_LOG=true
CACHE=false
DEVELOPMENT_MODE='all'

# ==========================
# Database
# ==========================
DB_HOST="${PROJECT_NAME}_db"
DB_PORT=3306
DB_NAME='example'
DB_USER='root'
DB_PASSWORD='root'
DB_CHARSET='utf8mb4'
DB_COLLATE='utf8mb4_0900_ai_ci'
DB_IMAGE='mysql:9.4.0'
TABLE_PREFIX='wp_'

# ==========================
# App / PHP / Node
# ==========================
APP_IMAGE='wordpress:php8.3'
APP_ENV='development'
APP_DEBUG=1

# ==========================
# WordPress Database
# ==========================
WORDPRESS_DB_HOST="${PROJECT_NAME}_db:${DB_PORT}"
WORDPRESS_DB_NAME="${DB_NAME}"
WORDPRESS_DB_USER="${DB_USER}"
WORDPRESS_DB_PASSWORD="${DB_PASSWORD}"
WORDPRESS_DB_CHARSET="${DB_CHARSET}"
WORDPRESS_DB_COLLATE="${DB_COLLATE}"
WORDPRESS_TABLE_PREFIX="${TABLE_PREFIX}"

# ==========================
# WordPress URLs
# ==========================
WP_HOME="https://${ROOT_URL}"
WP_SITEURL="https://${ROOT_URL}"

# ==========================
# WordPress Performance
# ==========================
WP_MEMORY_LIMIT='256M'
WP_MAX_MEMORY_LIMIT='512M'
COMPRESS_CSS=false
COMPRESS_SCRIPTS=false
CONCATENATE_SCRIPTS=false
ENFORCE_GZIP=false

# ==========================
# WordPress File System
# ==========================
FS_METHOD='direct'
DISALLOW_FILE_EDIT=false
DISALLOW_FILE_MODS=false

# ==========================
# WordPress Updates
# ==========================
AUTOMATIC_UPDATER_DISABLED=true
WP_AUTO_UPDATE_CORE=false

# ==========================
# WordPress Content Management
# ==========================
WP_POST_REVISIONS=5
AUTOSAVE_INTERVAL=300
EMPTY_TRASH_DAYS=30

# ==========================
# WordPress Debugging (Advanced)
# ==========================
SCRIPT_DEBUG=true
SAVEQUERIES=true

# ==========================
# WordPress Multisite (Optional)
# ==========================
WP_ALLOW_MULTISITE=false
MULTISITE=false
SUBDOMAIN_INSTALL=false
DOMAIN_CURRENT_SITE="${ROOT_URL}"
PATH_CURRENT_SITE='/'
SITE_ID_CURRENT_SITE=1
BLOG_ID_CURRENT_SITE=1

# ==========================
# WordPress Cookie Domain (Optional)
# ==========================
COOKIE_DOMAIN=''

# ==========================
# WordPress Auth Keys
# Generate unique keys: https://api.wordpress.org/secret-key/1.1/salt/
# ==========================
WORDPRESS_AUTH_KEY=''
WORDPRESS_SECURE_AUTH_KEY=''
WORDPRESS_LOGGED_IN_KEY=''
WORDPRESS_NONCE_KEY=''
WORDPRESS_AUTH_SALT=''
WORDPRESS_SECURE_AUTH_SALT=''
WORDPRESS_LOGGED_IN_SALT=''
WORDPRESS_NONCE_SALT=''
